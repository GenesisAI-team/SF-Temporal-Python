# Super Factory (SF-Temporal-Python) — configuration example
# Copy to .env and fill in. NEVER commit the real .env.

# Environment
SF_ENV=development
SF_LOG_LEVEL=info

# Temporal
SF_TEMPORAL_ADDRESS=localhost:7233
SF_TEMPORAL_NAMESPACE=default
SF_TEMPORAL_TASK_QUEUE=factory-orchestration

# Integrations (placeholders until H1/H2 — intentionally empty)
SF_LINEAR_WEBHOOK_SECRET=
SF_GITHUB_APP_ID=
SF_GITHUB_APP_PRIVATE_KEY_PATH=

# PostgreSQL (reserved for audit/metadata — H1+)
SF_DATABASE_URL=
