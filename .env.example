# Super Factory (SF-Temporal-Python) — configuration example
# Copy to .env and fill in. NEVER commit the real .env.

# Environment
SF_ENV=development
SF_LOG_LEVEL=info

# Temporal
SF_TEMPORAL_ADDRESS=localhost:7233
SF_TEMPORAL_NAMESPACE=default
SF_TEMPORAL_TASK_QUEUE=factory-orchestration

# Integrations (secretos solo por entorno; nunca los valores reales en el repo)
SF_LINEAR_WEBHOOK_SECRET=
SF_GITHUB_APP_ID=
SF_GITHUB_APP_PRIVATE_KEY_PATH=

# H1 — webhook Linear y selección durable
SF_LINEAR_TARGET_REPOSITORY=GenesisAI-team/SF-Temporal-Python
SF_LINEAR_SELECTABLE_STATES=Todo,In Progress
SF_LINEAR_TIMESTAMP_TOLERANCE_SECONDS=60
SF_LINEAR_DEDUPE_TTL_SECONDS=86400
SF_AUDIT_LOG_PATH=var/audit/events.jsonl

# PostgreSQL (reservado para auditoría/metadata persistente — H2+)
SF_DATABASE_URL=
