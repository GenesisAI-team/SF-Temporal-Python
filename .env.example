# Super Factory (SF-Temporal-Python) — configuration example
# Copy to .env and fill in. NEVER commit the real .env.

# Environment
SF_ENV=development
SF_LOG_LEVEL=info

# Temporal
SF_TEMPORAL_ADDRESS=localhost:7233
SF_TEMPORAL_NAMESPACE=default
SF_TEMPORAL_TASK_QUEUE=factory-orchestration

# Integrations (secretos solo por entorno; nunca los valores reales en el repo)
SF_LINEAR_WEBHOOK_SECRET=
SF_GITHUB_APP_ID=
SF_GITHUB_APP_PRIVATE_KEY_PATH=

# H1 — webhook Linear y selección durable
SF_LINEAR_TARGET_REPOSITORY=GenesisAI-team/SF-Temporal-Python
SF_LINEAR_SELECTABLE_STATES=Todo,In Progress
SF_LINEAR_TIMESTAMP_TOLERANCE_SECONDS=60
SF_LINEAR_DEDUPE_TTL_SECONDS=86400
SF_AUDIT_LOG_PATH=var/audit/events.jsonl

# H2 — pipeline de producción de PR (GEN-47): ver docs/runbooks/pipeline.md
SF_FACTORY_PIPELINE_ENABLED=false
SF_FACTORY_WORKSPACE_ROOT=var/factory/workspaces
SF_FACTORY_RUN_LEDGER_PATH=var/audit/runs.jsonl
SF_FACTORY_BUDGET_RUNS_PER_ISSUE=2
# Especificación aprobada (JSON ApprovedTaskSpec); vacía = falla explícito
SF_FACTORY_TASK_SPEC_PATH=
SF_FACTORY_SANDBOX_IMAGE=python:3.12-slim
SF_FACTORY_SANDBOX_CPU=1.0
SF_FACTORY_SANDBOX_MEMORY=2g
SF_FACTORY_SANDBOX_COMMAND_TIMEOUT_SECONDS=600
SF_FACTORY_BASE_BRANCH=main

# PostgreSQL (reservado para auditoría/metadata persistente — H2+)
SF_DATABASE_URL=
